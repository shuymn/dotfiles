{{- /* host.toml is the git-ignored host description shared with Nix; see `make host`. */ -}}
{{- $hostFile := joinPath .chezmoi.workingTree "host.toml" -}}
{{- if not (stat $hostFile) -}}
{{-   $hostFile = joinPath .chezmoi.workingTree "nix" "host.default.toml" -}}
{{- end -}}
{{- $role := (include $hostFile | fromToml).role -}}
{{- $roles := include (joinPath .chezmoi.workingTree "nix" "roles.toml") | fromToml -}}
{{- if not (hasKey $roles $role) -}}
{{-   fail (printf "unknown role %q in %s" $role $hostFile) -}}
{{- end -}}
sourceDir = {{ .chezmoi.workingTree | quote }}
encryption = "age"
color = false

[diff]
pager = "delta"

[data]
homeProfiles = {{ (index $roles $role).home | toJson }}

[age]
identity = "~/.config/age/key.txt"
{{- $ageIdentity := print .chezmoi.homeDir "/.config/age/key.txt" }}
{{- if stat $ageIdentity }}
{{- $ageRecipientScript := print .chezmoi.workingTree "/scripts/age-recipient.sh" }}
{{- $ageRecipient := output "/bin/sh" $ageRecipientScript $ageIdentity }}
recipient = {{ $ageRecipient | trim | quote }}
{{- end }}
