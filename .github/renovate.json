{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>shuymn/github-actions#main"],
  "platformAutomerge": true,
  "minimumReleaseAge": "1 days",
  "lockFileMaintenance": {
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Renovate compatibility version",
      "managerFilePatterns": ["/^\\.github\\/renovate-version$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate"
    },
    {
      "customType": "regex",
      "description": "Track pinned VS Code extensions through their GitHub releases",
      "managerFilePatterns": [
        "/^home\\/\\.chezmoiscripts\\/run_onchange_after_install-vscode-extensions\\.sh\\.tmpl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*install \\S+@(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Use the repository-wide one-day stability period for npm updates",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 days"
    }
  ],
  "mise": {
    "enabled": false
  },
  "nix": {
    "enabled": true
  }
}
