{{- /*
Terms `stack check public` rejects, one per line, rendered at apply time so no value is committed here:
the private string values of the git-ignored host.toml (the set scripts/kaizen/public-check reads: not the generic
values of nix/host.default.toml, not a role name, not a username equal to the GitHub owner of origin), the lines of
the unmanaged ~/.claude/kaizen/private-terms, and the T3 data directory fragments.
*/ -}}
# Generated by chezmoi from the dotfiles source; edit ~/.claude/kaizen/private-terms or host.toml instead.
{{- $host := joinPath .chezmoi.workingTree "host.toml" }}
{{- if stat $host }}
{{-   $public := include (joinPath .chezmoi.workingTree "nix" "host.default.toml") | fromToml }}
{{-   $roles := include (joinPath .chezmoi.workingTree "nix" "roles.toml") | fromToml }}
{{-   $origin := output "git" "-C" .chezmoi.workingTree "remote" "get-url" "origin" | trim }}
{{-   $owner := regexReplaceAll "^.*github\\.com[:/]([A-Za-z0-9-]+)/.*$" $origin "${1}" | lower }}
{{-   $publicValues := values $public }}
{{-   range $key, $value := include $host | fromToml }}
{{-     if and (kindIs "string" $value) (trim $value) (not (has $value $publicValues)) (not (hasKey $roles $value)) (not (and (eq $key "username") (eq (lower $value) $owner))) }}
{{ $value }}
{{-     end }}
{{-   end }}
{{- end }}
{{- $terms := joinPath .chezmoi.homeDir ".claude" "kaizen" "private-terms" }}
{{- if stat $terms }}
{{ include $terms | trimSuffix "\n" }}
{{- end }}
{{- range list "scratch" "worktrees" "userdata" }}
.t3/{{ . }}/
{{- end }}
