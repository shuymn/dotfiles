// Outer Zellij session used by Ghostty.
// Keep the terminal mostly pass-through and expose tmux-like commands behind
// Ctrl-b. Popups run as nested Zellij sessions in floating panes.

default_mode "normal"
default_layout "compact"

pane_frames true
scroll_buffer_size 100000
mouse_hover_effects false

keybinds clear-defaults=true {
    locked {
        // Emergency unlock. Ctrl-b intentionally stays unbound here so nested
        // Zellij popups can receive their own prefix while the outer session is
        // locked/pass-through.
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    normal {
        bind "Ctrl b" { SwitchToMode "Tmux"; }
    }

    tmux {
        bind "Ctrl b" { Write 2; SwitchToMode "Normal"; }
        bind "Esc" "Ctrl c" { SwitchToMode "Normal"; }

        // Panes: mirror the old tmux muscle memory.
        bind "s" "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "v" "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "H" { Resize "Increase Left"; SwitchToMode "Normal"; }
        bind "J" { Resize "Increase Down"; SwitchToMode "Normal"; }
        bind "K" { Resize "Increase Up"; SwitchToMode "Normal"; }
        bind "L" { Resize "Increase Right"; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind "b" { ToggleActiveSyncTab; SwitchToMode "Normal"; }

        // Tabs/sessions.
        bind "c" { NewTab { layout "compact-home"; }; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "d" { Detach; }

        // Copy/scroll mode.
        bind "[" { SwitchToMode "Scroll"; }

        // Persistent floating popup. The helper locks the outer session while
        // the nested Zellij is active, then restores normal mode on exit.
        bind "y" {
            Run "/bin/zsh" "-lc" "exec \"$HOME/.config/zellij/scripts/popup\"" {
                floating true
                close_on_exit true
                width "95%"
                height "90%"
                x "2%"
                y "5%"
                borderless true
            };
            SwitchToMode "Locked";
        }
    }

    scroll {
        bind "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }
}
