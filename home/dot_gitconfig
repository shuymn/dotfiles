[pull]
	rebase = true
	ff = only

[commit]
	verbose = true
	cleanup = scissors

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[init]
	defaultBranch = main

[alias]
	push-f = push --force-with-lease --force-if-includes
	root = rev-parse --show-toplevel
	files = diff --name-status
	staged-files = diff --cached --name-status
	adiff = !git --no-pager diff --no-ext-diff --color=never --find-renames --find-copies --unified=80
	astaged = !git --no-pager diff --cached --no-ext-diff --color=never --find-renames --find-copies --unified=80
	prune-gone = "!f() { git fetch --prune && git for-each-ref --format='%(upstream:track) %(refname:short)' refs/heads | awk '$1 == \"[gone]\" { sub(/^\\[gone\\] /, \"\"); print }' | while IFS= read -r branch; do worktree=$(git worktree list --porcelain | awk -v branch=\"refs/heads/$branch\" '$1 == \"worktree\" { path = substr($0, 10) } $1 == \"branch\" && $2 == branch { print path }'); if [ -n \"$worktree\" ]; then git worktree remove \"$worktree\" && git branch -d \"$branch\"; else git branch -d \"$branch\"; fi; done; }; f"

[rerere]
	enabled = true
	autoupdate = true

[core]
	pager = cat
	fsmonitor = false
	untrackedCache = true

[merge]
	conflictStyle = zdiff3

[diff]
	context = 3
	colorMoved = plain
	algorithm = histogram
	mnemonicPrefix = true
	renames = copies
	interHunkContext = 10

[credential "https://github.com"]
	helper =
	helper = "!gh auth git-credential"

[credential "https://gist.github.com"]
	helper =
	helper = "!gh auth git-credential"

[column]
	ui = auto

[branch]
	sort = -committerdate

[fetch]
	prune = true
	pruneTags = true
	all = true
	writeCommitGraph = true

[help]
	autoCorrect = prompt

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[wt]
	basedir = ../{gitroot}-worktrees

[tag]
	sort = version:refname

[status]
	branch = true
	showUntrackedFiles = all

[log]
	date = iso

[blame]
	ignoreRevsFile = .git-blame-ignore-revs

[include]
	path = ~/.config/git/config.local
