#!/bin/sh
# Install VS Code extensions at fixed versions. An @version install marks the
# extension pinned, so VS Code skips auto-updating it; Renovate bumps versions
# from each extension's GitHub releases.
set -eu
{{- if not (lookPath "code") }}

# VS Code is not installed yet (first converge runs chezmoi before nix-darwin).
# The script renders differently once `code` exists, so a later apply reruns it.
exit 0
{{- end }}

install() {
  code --install-extension "$1" --force
}

# renovate: datasource=github-releases depName=golang/vscode-go
install golang.go@0.58.0
# renovate: datasource=github-releases depName=VSCodeVim/Vim
install vscodevim.vim@1.32.4
