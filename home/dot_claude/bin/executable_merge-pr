#!/usr/bin/env bash
# Merge a PR only on the head that was checked, then read the result back.
# Usage: merge-pr <pr-number> <head-sha-or-prefix> [--merge|--squash|--rebase] [--delete-branch]
#                 [--subject <text>] [--body <text>] [--allow-no-checks] [--auto]
# Run inside a checkout of the PR's repository (GH_REPO is refused, so every read, the merge and the repository's
# own check see the same repository). It refuses unless the head is the one given, the PR is open, ready and
# mergeable, every check on the head passed (a failing check that is not required also refuses; no checks at all
# refuses unless --allow-no-checks), no fixup!/amend!/squash! commit is left for a non-squash merge, and
# <repo root>/.claude/merge-check <pr> <head> passes when that file is executable (repository-specific checks such
# as benchmarks or frozen oracles), and the PR touches no path listed in .claude/kaizen-managed on its base branch
# (such PRs are the owner's to merge). --auto is for a repository whose required check runs only on merge intent: it
# enables auto-merge on that head, waits up to 15 minutes for GitHub to merge it, and disables auto-merge again
# whenever that head was not the one merged (a later push would otherwise merge unchecked). Merge queues and --admin
# are out of scope.
set -euo pipefail
die() { echo "merge-pr: $*" >&2; exit 1; }
usage="usage: merge-pr <pr-number> <head-sha> [--merge|--squash|--rebase] [--delete-branch] [--subject s] [--body b] [--allow-no-checks] [--auto]"
pr=${1:?$usage}
want=${2:?$usage}
shift 2
[[ $pr =~ ^[0-9]+$ ]] || die "pass the PR number, not '$pr'"
[[ $want =~ ^[0-9a-f]{7,40}$ ]] || die "pass the head SHA (7-40 hex digits), not '$want'"
[[ -z ${GH_REPO:-} ]] || die "run inside the PR's repository instead of setting GH_REPO"
root=$(git rev-parse --show-toplevel 2>/dev/null || true)
[[ "$root/" != */.t3/worktrees/* && "$root/" != *-worktrees/agent-* ]] ||
  die "a delegated worktree does not merge: report the command to the orchestrator"

method='' allow_no_checks='' auto='' delete_branch='' flags=()
while (($#)); do
  case $1 in
    --merge|--squash|--rebase) [[ -z $method ]] || die "pass one merge method"; method=$1 ;;
    --delete-branch) delete_branch=1; flags+=("$1") ;;
    --subject|--body) (($# >= 2)) || die "$1 needs a value"; flags+=("$1" "$2"); shift ;;
    --allow-no-checks) allow_no_checks=1 ;;
    --auto) auto=1; flags+=("$1") ;;
    *) die "unsupported option '$1'. $usage" ;;
  esac
  shift
done
[[ -z $auto || -z $delete_branch ]] || die "--delete-branch is skipped by gh with --auto: delete the branch after the merge"

for _ in 1 2 3 4 5; do
  view=$(gh pr view "$pr" --json headRefOid,baseRefName,state,isDraft,mergeable)
  [[ $(jq -r .mergeable <<<"$view") != UNKNOWN ]] && break
  sleep 3
done
head=$(jq -r .headRefOid <<<"$view")
[[ $head == "$want"* ]] || die "head is $head, not $want: check the new head first"
[[ $(jq -r .state <<<"$view") == OPEN ]] || die "PR $pr is not open"
[[ $(jq -r .isDraft <<<"$view") == false ]] || die "PR $pr is a draft"
mergeable=$(jq -r .mergeable <<<"$view")
[[ $mergeable == MERGEABLE ]] || die "PR $pr is not mergeable ($mergeable; UNKNOWN means GitHub has not decided yet, retry)"

repo=$(gh repo view --json nameWithOwner,mergeCommitAllowed,squashMergeAllowed,rebaseMergeAllowed)
nwo=$(jq -r .nameWithOwner <<<"$repo")
if [[ -z $method ]]; then
  allowed=$(jq -r '[if .mergeCommitAllowed then "--merge" else empty end, if .squashMergeAllowed then "--squash" else empty end,
                    if .rebaseMergeAllowed then "--rebase" else empty end] | join(" ")' <<<"$repo")
  [[ -n $allowed && $allowed != *" "* ]] || die "the repository allows '$allowed': pass --merge, --squash or --rebase"
  method=$allowed
fi
if [[ $method != --squash ]]; then
  commits=$(gh pr view "$pr" --json commits -q '.commits[].messageHeadline') || die "could not read the PR's commits"
  marked=$(grep -E '^(fixup|amend|squash)! ' <<<"$commits" || true)
  [[ -z $marked ]] || die "fold these commits first (git rebase --autosquash), then check the new head:
$marked"
fi

if [[ -n $root && -x $root/.claude/merge-check ]]; then
  "$root/.claude/merge-check" "$pr" "$head" || die "$root/.claude/merge-check refused"
fi

err=$(mktemp) changed=$(mktemp)
armed=''  # set while auto-merge is enabled on a head this run has not seen merged
cleanup() {
  rm -f "$err" "$changed"
  [[ -z $armed ]] || gh pr merge "$pr" --disable-auto >/dev/null 2>&1 || echo "merge-pr: could not disable auto-merge: check the PR" >&2
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# The owner-only path list is read from one fetched base commit, never from the working tree or the PR head, so a PR
# cannot loosen it for itself. The dotfiles repository (a checkout or clone of the chezmoi source's repository) must
# have the list; elsewhere a list that cannot be read means no managed paths, as before the list existed.
base=$(jq -r .baseRefName <<<"$view")
list=.claude/kaizen-managed
src=$(chezmoi source-path) || die "could not resolve the chezmoi source, so whether $list applies is unknown"
common() { git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true; }
lower() { tr '[:upper:]' '[:lower:]' <<<"$1"; }
github_repo() {  # owner/repo of origin in the checkout at $1, lowercased; empty when it is not on GitHub
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null || true)
  url=${url%/}
  lower "$(sed -nE 's#^.*github\.com[:/]+([^/]+/[^/]+)$#\1#p' <<<"${url%.git}")"
}
here=$(common .) origin=$(github_repo .) src_origin=$(github_repo "$src")
dotfiles=''
[[ -n $here && $(common "$src") == "$here" ]] && dotfiles=1
[[ -n $src_origin && $src_origin == "$(lower "$nwo")" ]] && dotfiles=1
unreadable() { [[ -z $dotfiles ]] || die "$*, so PR $pr is not merged"; }
base_sha='' patterns=''
if [[ $origin != "$(lower "$nwo")" ]]; then
  unreadable "origin is '$origin' but gh resolves $nwo"
elif ! fetch_err=$(git fetch -q --no-tags origin "+refs/heads/$base:refs/remotes/origin/$base" 2>&1); then
  unreadable "could not fetch origin/$base: $fetch_err"
else
  base_sha=$(git rev-parse --verify "refs/remotes/origin/$base^{commit}") || die "could not resolve origin/$base"
  entry=$(git ls-tree --full-tree "$base_sha" -- "$list") || die "could not read the tree of origin/$base"
  read -r mode type oid _ <<<"$entry"
  if [[ -z $entry ]]; then
    unreadable "origin/$base has no $list"
  elif [[ $type != blob || ($mode != 100644 && $mode != 100755) ]]; then
    die "$list on origin/$base is not a regular file ($mode $type), so PR $pr is not merged"
  else
    patterns=$(git cat-file blob "$oid") || die "could not read $list from origin/$base"
    [[ -n ${patterns//[[:space:]]/} ]] || unreadable "$list on origin/$base is empty"
  fi
fi
if [[ -n $patterns ]]; then
  git cat-file -e "$head^{commit}" 2>/dev/null || git fetch -q --no-tags origin "refs/pull/$pr/head" ||
    die "could not fetch the head of PR $pr"
  mb=$(git merge-base "$base_sha" "$head") || die "could not find the merge base of $head and origin/$base"
  # Without renames, a file moved out of a managed path is listed under its old path too.
  git diff --name-only --no-relative --no-renames -z "$mb" "$head" >"$changed" ||
    die "could not list the files PR $pr changes"
  hits=()
  while IFS= read -r -d '' file; do
    while read -r pattern; do
      pattern=${pattern%$'\r'}
      # shellcheck disable=SC2053  # the pattern is a glob on purpose
      [[ -z $pattern || $file != $pattern ]] || { hits+=("$file"); break; }
    done <<<"$patterns"
  done <"$changed"
  ((${#hits[@]} == 0)) || die "PR $pr touches paths listed in $list on $base, so only the owner merges it, in the GitHub UI by \
enabling auto-merge on the checked head $head:
$(printf '%s\n' "${hits[@]}")"
fi

checks=$(gh pr checks "$pr" --json name,bucket 2>"$err" || true)  # judged by its content: valid JSON, or the no-checks error
if jq -e 'type == "array" and length > 0' <<<"$checks" >/dev/null 2>&1; then
  bad=$(jq -r '.[] | select(.bucket != "pass" and .bucket != "skipping") | "\(.bucket)\t\(.name)"' <<<"$checks")
  [[ -z $bad ]] || die "not every check on $head passed (pending: wait and rerun):
$bad"
elif [[ $checks == "[]" ]] || grep -q "no checks reported" "$err"; then
  [[ -n $allow_no_checks ]] || die "no checks ran on $head yet; wait for CI, or pass --allow-no-checks for a repository without CI"
else
  die "could not read the checks: $(cat "$err")"
fi

# shellcheck disable=SC2016  # GraphQL variables, not shell
queue=$(gh api graphql -f o="${nwo%%/*}" -f r="${nwo#*/}" -F n="$pr" \
  -f query='query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){isMergeQueueEnabled}}}' \
  -q .data.repository.pullRequest.isMergeQueueEnabled) || die "could not read whether the base uses a merge queue"
[[ $queue == false ]] || die "the base merges through a merge queue, which merge-pr does not handle"

if [[ -n $patterns ]]; then  # a retargeted or moved base was not the one the list and the diff came from
  now=$(gh pr view "$pr" --json baseRefName -q .baseRefName) || die "could not reread the base of PR $pr"
  [[ $now == "$base" ]] || die "PR $pr was retargeted from $base to $now: check it again"
  now=$(gh api "repos/$nwo/git/ref/heads/$base" -q .object.sha) || die "could not reread origin/$base"
  [[ $now == "$base_sha" ]] || die "$base moved from $base_sha to $now while PR $pr was checked: rerun"
fi
# The checks were read last, but a rerun can still start before the merge: required checks are what GitHub enforces.
rc=0
# With --auto the list is the one read above; only owner-merged PRs change it, so an extension governs later requests.
[[ -z $auto ]] || armed=1
gh pr merge "$pr" "$method" --match-head-commit "$head" ${flags[@]+"${flags[@]}"} || rc=$?
readback() { gh pr view "$pr" --json state,headRefOid,mergeCommit -q '"\(.state) \(.headRefOid) \(.mergeCommit.oid // "" | .[0:9])"' || echo "UNREAD"; }
result=$(readback)
if [[ -n $auto && $rc == 0 ]]; then
  deadline=$((SECONDS + 900))
  while [[ $result == "OPEN $head "* || $result == UNREAD ]] && ((SECONDS < deadline)); do
    sleep $((deadline - SECONDS < 20 ? deadline - SECONDS : 20))
    result=$(readback)
  done
fi
echo "$result"
[[ $result != MERGED* ]] || armed=''
[[ $rc == 0 ]] || echo "merge-pr: gh pr merge exited $rc (a cleanup step such as --delete-branch can fail after the merge)" >&2
if [[ $result != "MERGED $head "* ]]; then
  if [[ -n $auto && $result != MERGED* ]]; then
    if gh pr merge "$pr" --disable-auto >/dev/null 2>&1; then armed='' note="auto-merge disabled"; else note="retrying on exit"; fi
    die "PR $pr is not merged on $head ($result); $note"
  fi
  die "PR $pr is not merged on $head ($result)"
fi
