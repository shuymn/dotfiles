#!/bin/sh
# Manage shared Claude Code settings without overwriting runtime/local choices
# (model, effortLevel, enabledPlugins, UI toggles) that Claude Code writes itself.
exec chezmoi execute-template --with-stdin '
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = mustFromJson .chezmoi.stdin -}}
{{- end -}}
{{- $managed := `
{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_INSTALLATION_CHECKS": "1"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "WebFetch(domain:*)",
      "Bash(go:*)",
      "Bash(git:*)",
      "Bash(make:*)",
      "Bash(ls:*)",
      "Bash(eza:*)",
      "Bash(exa:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(bat:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ag:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(fzf:*)",
      "Bash(zoxide:*)",
      "Bash(z:*)",
      "Bash(which:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(fx:*)",
      "Bash(wget:*)",
      "Bash(httpie:*)",
      "Bash(http:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ping:*)",
      "Bash(nslookup:*)",
      "Bash(dig:*)",
      "Bash(netstat:*)",
      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(date:*)",
      "Bash(whoami)",
      "Bash(export:*)",
      "Bash(history)",
      "Bash(alias:*)",
      "Agent(**)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push -f origin main)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(sudo dd:*)",
      "Bash(sudo mkfs:*)",
      "Bash(sudo fdisk:*)",
      "Bash(sudo mount:*)",
      "Bash(sudo umount:*)",
      "Bash(> /dev/*)",
      "Bash(>> /dev/*)",
      "Bash(sudo:/usr/bin/passwd)",
      "Bash(sudo:/usr/sbin/vipw)",
      "Bash(chmod 777 /*)",
      "Bash(chown root:*)",
      "Bash(sudo chmod 777:*)",
      "Bash(sudo chown:*)",
      "Bash(sudo -i:*)",
      "Bash(sudo su:*)",
      "Bash(docker system prune -af)",
      "Bash(npm publish:*)",
      "Bash(cargo publish:*)",
      "Bash(deno publish:*)",
      "Edit(/etc/**)",
      "Edit(/usr/**)",
      "Edit(/var/**)",
      "Edit(/opt/**)",
      "Edit(/bin/**)",
      "Edit(/sbin/**)",
      "Edit(/lib/**)",
      "Edit(/lib64/**)",
      "Edit(/boot/**)",
      "Edit(/proc/**)",
      "Edit(/sys/**)",
      "Edit(/dev/**)",
      "Edit(~/.ssh/**)",
      "Edit(/etc/passwd)",
      "Edit(/etc/shadow)",
      "Edit(/etc/sudoers)",
      "Bash(git restore:*)",
      "Bash(git clean:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-git-worktree-add.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true
}
` | mustFromJson -}}
{{- $_ := set $settings "$schema" "https://json.schemastore.org/claude-code-settings.json" -}}
{{- $env := dict -}}
{{- if hasKey $settings "env" -}}
{{-   $env = get $settings "env" -}}
{{- end -}}
{{- $_ := set $settings "env" (mustMerge (get $managed "env") $env) -}}
{{- $permissions := dict -}}
{{- if hasKey $settings "permissions" -}}
{{-   $permissions = get $settings "permissions" -}}
{{- end -}}
{{- $_ := set $settings "permissions" (mustMergeOverwrite $permissions (get $managed "permissions")) -}}
{{- range $key := list "hooks" "statusLine" "attribution" "language" "alwaysThinkingEnabled" -}}
{{-   $_ := set $settings $key (get $managed $key) -}}
{{- end -}}
{{- $_ := unset $settings "includeCoAuthoredBy" -}}
{{ $settings | mustToPrettyJson }}
'
