#!/bin/sh
# Manage shared Claude Code settings without overwriting runtime/local choices
# (model, effortLevel, enabledPlugins, UI toggles) that Claude Code writes itself.
exec chezmoi execute-template --with-stdin '
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = mustFromJson .chezmoi.stdin -}}
{{- end -}}
{{- $managed := `
{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_INSTALLATION_CHECKS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(go:*)",
      "Bash(git:*)",
      "Bash(make:*)",
      "Bash(eza:*)",
      "Bash(exa:*)",
      "Bash(tree:*)",
      "Bash(bat:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(trash *)",
      "Bash(ln:*)",
      "Bash(chmod:*)",
      "Bash(rg:*)",
      "Bash(ag:*)",
      "Bash(fd:*)",
      "Bash(fzf:*)",
      "Bash(zoxide:*)",
      "Bash(z:*)",
      "Bash(sort:*)",
      "Bash(sed:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(fx:*)",
      "Bash(ping:*)",
      "Bash(nslookup:*)",
      "Bash(dig:*)",
      "Bash(netstat:*)",
      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Bash(date:*)",
      "Bash(whoami)",
      "Bash(export:*)",
      "Bash(history)",
      "Bash(alias:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout:*)",
      "Bash(git *--no-verify*)",
      "Bash(git stash)",
      "Bash(git stash push*)",
      "Bash(git stash save*)",
      "Bash(git stash -*)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push -f origin main)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf .git)",
      "Bash(sudo rm:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(sudo dd:*)",
      "Bash(sudo mkfs:*)",
      "Bash(sudo fdisk:*)",
      "Bash(sudo mount:*)",
      "Bash(sudo umount:*)",
      "Bash(chmod 777 /*)",
      "Bash(sudo chmod 777:*)",
      "Bash(sudo chown:*)",
      "Bash(sudo -i:*)",
      "Bash(sudo su:*)",
      "Bash(docker system prune -af)",
      "Bash(npm publish:*)",
      "Bash(cargo publish:*)",
      "Bash(deno publish:*)",
      "Edit(~/.ssh/**)",
      "Bash(git restore:*)",
      "Bash(git clean:*)"
    ],
    "ask": [
      "Bash(*wrangler *deploy*)",
      "Bash(*wrangler *secret*)",
      "Bash(*wrangler *r2*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-git-worktree-add.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-rm.sh",
            "if": "Bash(rm *)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/ask-git-push-protected.py",
            "if": "Bash(git *)"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "worktree": {
    "baseRef": "fresh"
  }
}
` | mustFromJson -}}
{{- /* Defaults fill only keys the live file lacks; Claude Code rewrites these itself. */ -}}
{{- $defaults := `
{
  "model": "opus[1m]",
  "fallbackModel": ["sonnet"],
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "outputStyle": "Concise",
  "tui": "fullscreen",
  "editorMode": "normal",
  "askUserQuestionTimeout": "never",
  "enableWorkflows": true,
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": false,
  "extraKnownMarketplaces": {
    "shuymn-codex": {
      "source": {
        "source": "github",
        "repo": "shuymn/codex-plugin-cc"
      }
    }
  },
  "enabledPlugins": {
    "codex@shuymn-codex": true
  }
}
` | mustFromJson -}}
{{- $settings = mustMergeOverwrite (deepCopy $defaults) $settings -}}
{{- $_ := set $settings "$schema" "https://json.schemastore.org/claude-code-settings.json" -}}
{{- $env := dict -}}
{{- if hasKey $settings "env" -}}
{{-   $env = get $settings "env" -}}
{{- end -}}
{{- $_ := set $settings "env" (mustMerge (get $managed "env") $env) -}}
{{- $permissions := dict -}}
{{- if hasKey $settings "permissions" -}}
{{-   $permissions = get $settings "permissions" -}}
{{- end -}}
{{- $_ := set $settings "permissions" (mustMergeOverwrite $permissions (get $managed "permissions")) -}}
{{- range $key := list "hooks" "statusLine" "attribution" "language" "alwaysThinkingEnabled" -}}
{{-   $_ := set $settings $key (get $managed $key) -}}
{{- end -}}
{{- $worktree := dict -}}
{{- if hasKey $settings "worktree" -}}
{{-   $worktree = get $settings "worktree" -}}
{{- end -}}
{{- $_ := set $settings "worktree" (mustMergeOverwrite $worktree (get $managed "worktree")) -}}
{{- $_ := unset $settings "includeCoAuthoredBy" -}}
{{ $settings | mustToPrettyJson }}
'
