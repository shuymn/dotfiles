#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Check what a push or a PR would publish for local paths, host.toml values and private terms.

Run before `git push` and `gh pr create`/`edit`, with the exact range and metadata that will be published.
Every commit in RANGE is checked (the paths and lines it adds, and its message), not only the end state, because a
push publishes intermediate commits too.

Rejected: absolute local paths, string values from the repository's git-ignored host.toml (except the generic ones
in nix/host.default.toml, the role names in nix/roles.toml, and a username that is the GitHub owner in origin's
URL), and each line of ~/.claude/kaizen/private-terms.
With --host-toml and --private-terms (both, as files that must be readable), those files are read instead and no
working tree is looked for, so RANGE can be checked in a bare repository; the caller sets git's environment.
Not caught: private words that are in none of these (add them to private-terms), and text that is published by
other means than RANGE and the given metadata.

Exit status: 0 clean, 1 a hit (each one is named), 2 usage or git error.
"""

import argparse
import re
import subprocess
import sys
import tomllib
from pathlib import Path

# LOCAL_PATH in ~/.claude/hooks/guard-agent-actions.py, but a home or volume path must start the token (so the
# repository's own home/ directory is not a hit) and may end it without a slash; /Volumes is added. [s] keeps this
# line from matching itself.
LOCAL_PATH = re.compile(r"(?<![\w.-])(?:/Users|/home|/Volumes)/[A-Za-z0-9._-]+(?:/|(?![A-Za-z0-9._-]))"
                        r"|\.t3/(?:scratch|worktrees|userdata)/|/tmp/claude-\d+/|/private/var/folder[s]/")


def die(message: str) -> None:
    print(f"public-check: {message}", file=sys.stderr)
    sys.exit(2)


def git(*args: str, check: bool = True) -> str:
    """Git's output decoded as is: universal newlines would turn a bare CR into a line break."""
    result = subprocess.run(["git", *args], capture_output=True)
    if result.returncode != 0 and not check:
        return ""
    if result.returncode != 0:
        die(f"git {' '.join(args)} failed: {result.stderr.decode(errors='replace').strip()}")
    return result.stdout.decode(errors="replace")


def read(path: Path, missing: str | None = None) -> str:
    """The file's text; `missing` stands in for a file that does not exist, which is otherwise an error."""
    try:
        return path.read_text()
    except FileNotFoundError:
        if missing is None:
            die(f"cannot read {path}: no such file")
        return missing
    except (OSError, UnicodeDecodeError) as e:
        die(f"cannot read {path}: {e}")


def parse_toml(text: str, name: str) -> dict:
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        die(f"cannot parse {name}: {e}")


def owner_login() -> str:
    """The GitHub owner in origin's URL, which every repository URL and merge commit already publishes."""
    m = re.search(r"github\.com[:/]([A-Za-z0-9-]+)/", git("remote", "get-url", "origin", check=False))
    return m.group(1).lower() if m else ""


def host_values(root: Path | None, main: Path | None, base: str, files: list[Path] | None = None) -> set[str]:
    """String values of host.toml; a linked worktree has none of its own, so the main checkout's is used. Given files,
    those are read instead, and each must exist. The generic values are read from the range's base, so a commit in
    the range cannot exempt a value by adding it there."""
    def at_base(name: str) -> dict:
        return parse_toml(git("show", f"{base}:{name}", check=False), f"{base}:{name}")

    public = {v for v in at_base("nix/host.default.toml").values() if isinstance(v, str)}
    public |= set(at_base("nix/roles.toml"))
    owner = owner_login()
    missing = None if files else ""
    return {v for f in files or (root / "host.toml", main / "host.toml")
            for key, v in parse_toml(read(f, missing), str(f)).items()
            if isinstance(v, str) and v.strip() and v not in public and not (key == "username" and v.lower() == owner)}


def private_terms(path: Path | None = None) -> list[str]:
    """The terms of path, which must exist; without one, of ~/.claude/kaizen/private-terms, missing counting as empty."""
    text = read(path, None) if path else read(Path.home() / ".claude/kaizen/private-terms", "")
    return [t for line in text.splitlines() if (t := line.strip()) and not t.startswith("#")]


def added_lines(patch: str) -> str:
    """The lines a patch adds. Headers (old names, quoted paths) and removed or context lines are left out."""
    added, in_hunk = [], False
    for line in patch.split("\n"):  # not splitlines(): U+2028 or a bare CR inside an added line is not a line break
        if line.startswith("diff --git "):
            in_hunk = False
        elif line.startswith("@@"):
            in_hunk = True
        elif in_hunk and line.startswith("+"):
            added.append(line[1:])
    return "\n".join(added)


def scan(where: str, text: str, hosts: list[str], terms: list[str]) -> list[str]:
    lower = text.lower()
    return ([f"{where}: local path {m.group(0)!r}" for m in LOCAL_PATH.finditer(text)]
            + [f"{where}: a host.toml value ({v!r})" for v in hosts if v.lower() in lower]
            + [f"{where}: private term {t!r}" for t in terms if t.lower() in lower])


def main() -> int:
    parser = argparse.ArgumentParser(prog="public-check", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("range", metavar="RANGE", help="commits to publish, as <base>..<head>")
    parser.add_argument("--title", help="PR title")
    parser.add_argument("--body-file", type=Path, help="file holding the PR body")
    parser.add_argument("--branch", help="branch name")
    parser.add_argument("--host-toml", type=Path, help="the host.toml to read (with --private-terms)")
    parser.add_argument("--private-terms", type=Path, help="the private-terms file to read (with --host-toml)")
    args = parser.parse_args()
    if (args.host_toml is None) != (args.private_terms is None):
        parser.error("--host-toml and --private-terms go together")
    ends = args.range.split("..")
    if len(ends) != 2 or not all(ends) or any(e.startswith(".") or e.endswith(".") for e in ends):
        parser.error("RANGE must be <base>..<head>")

    if args.host_toml is not None:
        hosts = sorted(host_values(None, None, ends[0], [args.host_toml]))
    else:
        root = Path(git("rev-parse", "--show-toplevel").strip())
        main_checkout = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir").strip()).parent
        hosts = sorted(host_values(root, main_checkout, ends[0]))
    terms = private_terms(args.private_terms)

    texts = []  # (where, text)
    for sha in git("rev-list", "--reverse", args.range).split():
        short = sha[:9]
        texts.append((f"commit {short} message", git("show", "-s", "--format=%B", sha)))
        common = ("show", "--format=", "-M", "--no-relative", "--diff-merges=first-parent")
        # Destination names only: a deleted or renamed-away name is not published anew.
        names = git(*common, "--name-only", "-z", "--diff-filter=ACMRT", sha)
        texts.append((f"commit {short} path", names.replace("\0", "\n")))
        patch = git(*common, "--patch", "--text", "--no-color", "--no-ext-diff", "--no-textconv", sha)
        texts.append((f"commit {short} diff", added_lines(patch)))
    if args.title is not None:
        texts.append(("--title", args.title))
    if args.body_file is not None:
        texts.append(("--body-file", read(args.body_file)))
    if args.branch is not None:
        texts.append(("--branch", args.branch))

    hits = {}  # ordered and without repeats
    for where, text in texts:
        hits.update(dict.fromkeys(scan(where, text, hosts, terms)))
    for hit in hits:
        print(f"public-check: {hit}", file=sys.stderr)
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
