#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Check what a push or a PR would publish for local paths, host.toml values and private terms.

Run before `git push` and `gh pr create`/`edit`, with the exact range and metadata that will be published.
Every commit in RANGE is checked (the lines its diff adds and its message), not only the end state, because a push
publishes intermediate commits too.

Rejected: absolute local paths, string values from the repository's git-ignored host.toml (except the generic ones
in nix/host.default.toml, the role names in nix/roles.toml and the GitHub owner in origin's URL), and each line of
~/.claude/kaizen/private-terms.
Not caught: private words that are in none of these (add them to private-terms), and text that is published by
other means than RANGE and the given metadata.

Exit status: 0 clean, 1 a hit (each one is named), 2 usage or git error.
"""

import argparse
import re
import subprocess
import sys
import tomllib
from pathlib import Path

# LOCAL_PATH in ~/.claude/hooks/guard-agent-actions.py, but /Users and /home must start a path, so the repository's
# own home/ directory in a diff header (b/home/...) is not a hit.
LOCAL_PATH = re.compile(r"(?<![\w.-])(?:/Users|/home)/[A-Za-z0-9._-]+/|\.t3/(?:scratch|worktrees|userdata)/|/tmp/claude-\d+/|/private/var/folders/")


def die(message: str) -> None:
    print(f"public-check: {message}", file=sys.stderr)
    sys.exit(2)


def git(*args: str, check: bool = True) -> str:
    result = subprocess.run(["git", *args], capture_output=True, text=True, errors="replace")
    if result.returncode != 0 and not check:
        return ""
    if result.returncode != 0:
        die(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def read_toml(path: Path) -> dict:
    try:
        return tomllib.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except tomllib.TOMLDecodeError as e:
        die(f"cannot parse {path}: {e}")


def owner_login() -> str:
    """The GitHub owner in origin's URL, which every repository URL and merge commit already publishes."""
    m = re.search(r"github\.com[:/]([A-Za-z0-9-]+)/", git("remote", "get-url", "origin", check=False))
    return m.group(1).lower() if m else ""


def host_values(root: Path, main: Path) -> set[str]:
    """String values of host.toml; a linked worktree has none of its own, so the main checkout's is used."""
    values = {v for d in (root, main) for v in read_toml(d / "host.toml").values() if isinstance(v, str)}
    public = {v for v in read_toml(root / "nix/host.default.toml").values() if isinstance(v, str)}
    public |= set(read_toml(root / "nix/roles.toml"))
    owner = owner_login()
    return {v for v in values - public if v.strip() and v.lower() != owner}


def private_terms() -> list[str]:
    path = Path.home() / ".claude/kaizen/private-terms"
    if not path.exists():
        return []
    return [t for line in path.read_text().splitlines() if (t := line.strip()) and not t.startswith("#")]


def added_text(diff: str) -> str:
    """The lines a diff publishes anew: added lines and new paths, not removed or context lines."""
    return "\n".join(line for line in diff.splitlines() if not line.startswith(("-", " ", "@@", "\\")))


def main() -> int:
    parser = argparse.ArgumentParser(prog="public-check", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("range", metavar="RANGE", help="commits to publish, as <base>..<head>")
    parser.add_argument("--title", help="PR title")
    parser.add_argument("--body-file", type=Path, help="file holding the PR body")
    parser.add_argument("--branch", help="branch name")
    args = parser.parse_args()
    if ".." not in args.range:
        parser.error("RANGE must be <base>..<head>")

    root = Path(git("rev-parse", "--show-toplevel").strip())
    main_checkout = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir").strip()).parent
    hosts = sorted(host_values(root, main_checkout))
    terms = private_terms()

    texts = []  # (where, text)
    for sha in git("rev-list", "--reverse", args.range).split():
        short = sha[:9]
        texts.append((f"commit {short} message", git("show", "-s", "--format=%B", sha)))
        diff = git("show", "--format=", "--patch", "--text", "--no-color", "--no-ext-diff",
                   "--diff-merges=first-parent", sha)
        texts.append((f"commit {short} diff", added_text(diff)))
    if args.title is not None:
        texts.append(("--title", args.title))
    if args.body_file is not None:
        try:
            texts.append(("--body-file", args.body_file.read_text()))
        except OSError as e:
            die(f"cannot read --body-file: {e}")
    if args.branch is not None:
        texts.append(("--branch", args.branch))

    hits = {}  # ordered and without repeats
    for where, text in texts:
        hits.update(dict.fromkeys(f"{where}: local path {m.group(0)!r}" for m in LOCAL_PATH.finditer(text)))
        lower = text.lower()
        hits.update(dict.fromkeys(f"{where}: a host.toml value ({v!r})" for v in hosts if v.lower() in lower))
        hits.update(dict.fromkeys(f"{where}: private term {t!r}" for t in terms if t.lower() in lower))
    for hit in hits:
        print(f"public-check: {hit}", file=sys.stderr)
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
